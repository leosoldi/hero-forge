{
  "name": "hero-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestão de heróis: API REST (NestJS + TypeORM), front-end (React + Vite) e MySQL em Docker.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose stop mysql",
    "db:logs": "docker compose logs -f mysql",
    "db:reset": "docker compose down -v && docker compose up -d mysql",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web",
    "docker:ps": "docker compose ps",
    "api:dev": "npm run start:dev -w apps/api",
    "api:test": "npm run test -w apps/api",
    "api:test:e2e": "npm run test:e2e -w apps/api",
    "api:test:cov": "npm run test:cov -w apps/api",
    "web:dev": "npm run dev -w apps/web",
    "web:test": "npm run test -w apps/web",
    "web:test:cov": "npm run test:cov -w apps/web",
    "web:build": "npm run build -w apps/web"
  }
}
