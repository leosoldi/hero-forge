# MySQL (docker-compose). Usuário e senha locais de desenvolvimento,
# os mesmos do apps/api/.env.example.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hero_forge
MYSQL_USER=hero_forge
MYSQL_PASSWORD=hero_forge
MYSQL_PORT=3306

# Portas publicadas pelo "docker compose up" (opcionais)
# API_PORT=3333
# WEB_PORT=8080

# IA generativa real (opcional). Sem estas linhas, a IA roda em modo demonstração.
# Para ativar no Docker: descomente, preencha e rode "docker compose up -d".
# (No modo de desenvolvimento, as mesmas chaves vão em apps/api/.env.)
# AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
