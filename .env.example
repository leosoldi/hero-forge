# MySQL (docker-compose). Usuário e senha locais de desenvolvimento,
# os mesmos do apps/api/.env.example.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hero_forge
MYSQL_USER=hero_forge
MYSQL_PASSWORD=hero_forge
MYSQL_PORT=3306

# Portas publicadas pelo "docker compose up" (opcionais)
# API_PORT=3333
# WEB_PORT=8080

# As chaves da IA (Cloudflare) ficam em apps/api/.env. O Docker reaproveita
# esse arquivo; sem ele, a IA roda em modo demonstração.
